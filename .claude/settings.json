{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Edit(/src/client/scenes/*.scene)",
      "Edit(/src/server/scores.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push)",
      "Bash(git push *)"
    ]
  }
}
