{
  "compilerOptions": {
    "target": "es6",
    "experimentalDecorators": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": false,
    "types": ["phaser"],
    "allowJs": false,
    "outDir": "../../build/server",
    "inlineSourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
