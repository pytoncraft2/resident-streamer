{
  "compilerOptions": {
    "target": "es6",
    "experimentalDecorators": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": false,
    "types": ["phaser"],
    "allowJs": false,
    // Racine src/ : src/server → build/server (chemins inchangés), src/shared → build/shared (ADR-002).
    "rootDir": "..",
    "outDir": "../../build",
    "inlineSourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
